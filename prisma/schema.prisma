generator client {
  provider = "prisma-client-js"
  seed     = "node ./prisma/seed.ts"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
}

model Guest {
  id        String   @id @default(cuid())
  name      String?
  email     String?  @unique
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  comment   String?

  @@map("guests")
}

model Post {
  id         	String    @id @default(cuid())
  categoryId 	Int?
  title      	String
  content    	String
  image      	String?
  published  	Boolean   @default(false)
  authorId   	String?
  source			String?
  createdAt  	DateTime  @default(now()) @map("created_at")
  updatedAt  	DateTime  @updatedAt @map("updated_at")

  category   	Category? @relation(fields: [categoryId], references: [id])
  author     	User?     @relation(fields: [authorId], references: [id])
  comments   	Comment[]
}

model Category {
  id    Int     @id @default(autoincrement())
  name  String
  posts Post[]
}

model User {
  id        String   @id @default(cuid())
  name      String?
  email     String   @unique
  role      String   @default("user")
  password  String?  
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  posts     Post[]

  @@map("users")
}

model Comment {
  id         String   @id @default(cuid())
  postId     String
  guestName  String
  guestEmail String?
  text       String
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamp(6)
  post       Post     @relation(fields: [postId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("comments")
}



model NftCollection {
  id          Int        @id @default(autoincrement())
  network     String
  contractId  String
  name        String
  description String?
  maxCopies   Int        @default(1)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  tokens      NftToken[]

  @@unique([network, contractId, name])
  @@index([network, contractId])
}

model NftToken {
  id              Int           @id @default(autoincrement())
  network         String
  contractId      String
  tokenId         String
  priceYocto      String
  saleHistory     String?
  visible         Boolean?
  title           String?
  description     String?
  media           String?
  ownerId         String?
  holders         String[]
  royalties       String?
  metadataJson    String?
  status          String?
  illustrationUrl String?
  copies          Int?
  mintTxHash      String?
  buyTxHash       String?
  collectionId    Int?
  collection      NftCollection? @relation(fields: [collectionId], references: [id], onDelete: SetNull)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@unique([network, contractId, tokenId])
  @@index([network, contractId, visible])
  @@index([collectionId])
}

model Page {
  id        String    @id @default(cuid())
  name      String    @unique // e.g., "whoami", "contact", "marketplace"
  slug      String    @unique // URL path, e.g., "/whoami"
  isActive  Boolean   @default(true)
  order     Int       @default(0)
  type      String    @default("main") // "main", "secondary", "footer"
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  contents  Content[]
  footerItems FooterItem[]
}

model Content {
  id        String    @id @default(cuid())
  pageId    String
  page      Page      @relation(fields: [pageId], references: [id], onDelete: Cascade)
  locale    String    @default("en") // "en", "pt"
  body      String    @db.Text
  version   Int       @default(1)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime? // Soft delete

  @@unique([pageId, locale, version])
  @@index([pageId, locale, version])
}

model FooterItem {
  id        String    @id @default(cuid())
  pageId    String? // Optional, if a footer item is specific to a page
  page      Page?     @relation(fields: [pageId], references: [id])
  text      String
  link      String?
  iconClass String? // e.g., "bi bi-github"
  order     Int       @default(0)
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime? // Soft delete
}




