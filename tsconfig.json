{
  "compilerOptions": {
    "experimentalDecorators": true,
    "target": "ES5",
    "noImplicitAny": false,
    "baseUrl": ".",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@/globals.css": [
        "src/app/globals.css"
      ],
      "@/prisma": [
        "lib/prisma.ts"
      ],
      "@rootLayout": [
        "src/app/layout.tsx"
      ],
      "@/layout/*": [
        "src/app/_components/*"
      ],
      "@/blog/components/*": [
        "src/app/(alternatives)/blog/_components/*"
      ],
      "@MyAlbuns": [
        "myalbuns.js"
      ],
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    "lib/mydata.js",
    "prisma/seed.js"
  ],
  "exclude": [
    "node_modules"
  ]
}