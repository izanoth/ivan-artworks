{
  "compilerOptions": {
    "experimentalDecorators": true,
    "target": "ES2020",
    "noImplicitAny": false,
    "baseUrl": ".",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@/globals.css": [
        "src/app/globals.css"
      ],
      "@/prisma": [
        "lib/prisma.ts"
      ],
      "@/auth": [
        "lib/auth.ts"
      ],
      "@/firebase-admin": [
        "/lib/firebase-admin"
      ],
      "@rootLayout": [
        "src/app/layout.tsx"
      ],
      "@/layout/*": [
        "src/app/_components/*"
      ],
      "@/blog/components/*": [
        "src/app/(odds)/blog/_components/*"
      ],
      "@MyAlbuns": [
        "myalbuns.js"
      ],
      "@/admin/components/*": [
			"src/app/(odds)/admin/_components/*"      
      ],
      "@near/*": [
        "./src/near-studio/*"
      ],
      "@/near/*": [
        "./src/near-studio/*"
      ],
      "@near-studio/*": [
        "./src/near-studio/*"
      ],
      "@/near-service": [
        "./src/near-studio/services/near.js"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    "lib/mydata.js",
    "prisma/seed.js"
  ],
  "exclude": [
    "node_modules"
  ]
}
