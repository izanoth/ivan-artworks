'use client';

import { useState } from "react";

type Author = {
  id: string;
  name: string | null;
  email: string | null;
  createdAt: Date;
  updatedAt: Date;
};

type Props = {
  authors: (Author | null)[];
};


export default function AuthorSelect({ authors }: Props) {

  return (
  	 <div>
  	 	<label htmlFor="author" className="block text-sm font-medium">
        Autor
      </label>
	   <select
	     id="author"
	     name="authorId"
	     className="mt-1 block w-full rounded-md border p-2"
	   >
	     <option value="">Selecione um autor</option>
	     {authors.map((author) => (
			  <option key={author.id} value={author.id}>
			    {author.name ?? "Sem nome"}
			  </option>) : null
			)}
	   </select>
	 </div>
  );
}
