import { NextRequest, NextResponse } from 'next/server'
import { prisma } from '@/lib/prisma'

type Role = 'admin' | 'editor' | 'user' | 'guest'

function getAuthFromRequest(req: NextRequest): { role: Role; username: string | null } {
  const role = (req.cookies.get('role')?.value as Role) || 'guest'
  const username = req.cookies.get('username')?.value || null
  return { role, username }
}

export async function POST(req: NextRequest) {
  const { role, username } = getAuthFromRequest(req)

  if (role !== 'admin' && role !== 'editor') {
    return NextResponse.json({ error: 'Unauthorized' }, { status: 401 })
  }

  try {
    const formData = await req.formData();

    // Se for editor → força authorId = username
    let authorId: string | null = null
    if (role === 'admin') {
      authorId = data.authorId ?? username
    } else if (role === 'editor') {
      authorId = username // editor sempre só cria para si
    }

    if (!authorId) {
      return NextResponse.json({ error: 'Missing authorId' }, { status: 400 })
    }

	 const title = formData.get("title")?.toString() || "";
    const authorId = formData.get("authorId")?.toString() || "";
	 const categoryId = Number(formData.get('categoryId'));    
    const content = formData.get("content")?.toString() || "";
    const postRequest = (role === 'editor' ? true : "");
    const published = formData.get("published") === "on" || formData.get("published") === "true";
    
    const newPost = await prisma.post.create({
      data: {
        title,
        content,
        published,
        categoryId,
        postRequest,
        authorId,
      },
    });
    
    // notifica hub
    const hubUrl = "https://pubsubhubbub.appspot.com/";
    const feedUrl = "https://zanoth.vercel.app/blog/feed.xml";
    fetch(hubUrl, {
      method: "POST",
      headers: { "Content-Type": "application/x-www-form-urlencoded" },
      body: new URLSearchParams({
        "hub.mode": "publish",
        "hub.url": feedUrl,
      }),
    }).catch(console.error);

    return NextResponse.json(newPost, { status: 201 })
  } catch (err) {
    console.error('POST /api/blog/create error:', err)
    return NextResponse.json({ error: 'Internal Server Error' }, { status: 500 })
  }
}
